# mailo's sync daemon as a systemd user service: `mailo watch` fetches mail for every account for
# as long as the session lasts, announces what arrives through the desktop's notification server
# (org.freedesktop.Notifications) and keeps the unread count on the launcher entry
# (com.canonical.Unity.LauncherEntry). It works in any session that reaches
# graphical-session.target, with the window open or not, and needs no knowledge of mailo from the
# shell. `mailo watch` takes a per-user lock and exits 0 when one is already running, so this unit
# and a watch started by hand never announce twice.
#
# Installed by dist/install.sh into /etc/systemd/user and enabled globally; dist/uninstall.sh
# disables it.
[Unit]
Description=mailo mail sync (new-mail banners and the unread count)
Documentation=https://github.com/PoHsuanLai/mailo
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=900
StartLimitBurst=10

[Service]
Type=simple
# In its own scope, named `app-org.quire.Mail-watch<boot id>.scope` under app.slice: accountd proves
# an app by the scope its process runs in, and a service's cgroup is not one. `%b` is the boot id
# (alphanumeric, as a scope's random part must be). The scope is the unit's main process.
ExecStart=/usr/bin/systemd-run --user --scope --collect --quiet --unit=app-org.quire.Mail-watch%b.scope --slice=app.slice /usr/local/bin/mailo watch
# A watch does not end because an account cannot sync (no credential, a refused sign-in): it says
# so once and idles until the accounts change. What ends it with a failure is the watch itself
# being unable to run (an unreadable store), which a restart seldom fixes, so the retry waits
# a minute and stops for good after ten in a quarter of an hour.
Restart=on-failure
RestartSec=60
# A mail client's background half should not compete with the foreground.
Nice=5
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
